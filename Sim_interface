#Fonction pour l'evolution de la temperature dans la plaque

def vector_evolution_temperature(T, pos_ac, nx_ac, ny_ac, P_ac=None,
                               P_pert=None, pos_pert=None, nx_pert=None, ny_pert=None):
    T_new = T.copy()

    # Conduction éléments centraux
    T_new[1:-1,1:-1] = T[1:-1, 1:-1] + a*dt*((T[2:,1:-1]-2*T[1:-1, 1:-1] +T[0:-2, 1:-1])/(dy**2) +
                                           (T[1:-1,2:]-2*T[1:-1, 1:-1] +T[1:-1, 0:-2])/(dx**2))
    
    # Conduction bords et coins
    T_new[0, 1:-1] += a * dt * ((T[1, 1:-1] - T[0, 1:-1]) / dy**2 +
                               (T[0, 2:] - 2 * T[0, 1:-1] + T[0, :-2]) / dx**2)
    
    T_new[-1, 1:-1] += a * dt * ((T[-2, 1:-1] - T[-1, 1:-1]) / dy**2 +
                                (T[-1, 2:] - 2 * T[-1, 1:-1] + T[-1, :-2]) / dx**2)
    
    T_new[1:-1, 0] += a * dt * ((T[2:, 0] - 2 * T[1:-1, 0] + T[:-2, 0]) / dy**2 +
                               (T[1:-1, 1] - T[1:-1, 0]) / dx**2)
    
    T_new[1:-1, -1] += a * dt * ((T[2:, -1] - 2 * T[1:-1, -1] + T[:-2, -1]) / dy**2 +
                                (T[1:-1, -2] - T[1:-1, -1]) / dx**2)
    
    # Coins
    T_new[0, 0] += a * dt * ((T[1, 0] - T[0, 0]) / dy**2 + (T[0, 1] - T[0, 0]) / dx**2)   
    T_new[0, -1] += a * dt * ((T[1, -1] - T[0, -1]) / dy**2 + (T[0, -2] - T[0, -1]) / dx**2) 
    T_new[-1, 0] += a * dt * ((T[-2, 0] - T[-1, 0]) / dy**2 + (T[-1, 1] - T[-1, 0]) / dx**2)   
    T_new[-1, -1] += a * dt * ((T[-2, -1] - T[-1, -1]) / dy**2 + (T[-1, -2] - T[-1, -1]) / dx**2)

    # Convection
    Coeff = (h*dt)/(p*cp)
    T_new[0, :] += 1*Coeff*(T_air-T[0,:])*((dz*dx)/(vol))     # haut   #ici, j'ai mis un coefficient 1 parce que si je veux enlever la convection juste sur 1 cote, il me suffira juste de rempacer 1 par 0
    T_new[-1, :] += 1*Coeff*(T_air-T[-1,:])*((dz*dx)/(vol))   # bas
    T_new[:,0] += 1*Coeff*(T_air-T[:,0])*((dz*dy)/(vol))      # gauche
    T_new[:,-1] += 1*Coeff*(T_air-T[:,-1])*((dz*dy)/(vol))    # droite
    T_new[:,:] += 2*Coeff*(T_air-T[:,:])*((dx*dy)/vol)      # dessus/dessous  #ici, le coefficient doit etre a 2 si on veut que les 2 surfaces soient soumises a la convection

    # Actuateur
    if P_ac is not None:
        i, j = pos_ac
        P_par_element = P_ac/(nx_ac*ny_ac)
        T_new[i-nx_ac//2:i+nx_ac//2, j-ny_ac//2:j+ny_ac//2] += (P_par_element*dt)/(p*cp*vol)

    # Perturbation
    if P_pert is not None and P_pert > 0:
        k, l = pos_pert
        P_par_element = P_pert/(nx_pert*ny_pert)
        T_new[k-nx_pert//2:k+nx_pert//2, l-ny_pert//2:l+ny_pert//2] += (P_par_element*dt)/(p*cp*vol)

    return T_new
























#classe qui permet d'afficher l'interface graphique

class SimulationApp(QWidget):
    def __init__(self):
        super().__init__()
        self.initUI()
        self.animation = None

    def initUI(self):
        layout = QVBoxLayout()
        plt.ioff()

        #Graphique principal
        self.figure, self.ax = plt.subplots()
        self.canvas = FigureCanvas(self.figure)
        layout.addWidget(self.canvas)

        #Boutons de simulation pour 2D et 3D
        self.start_2D_btn = QPushButton('Démarrer 2D')
        self.start_2D_btn.clicked.connect(self.start_2D)
        layout.addWidget(self.start_2D_btn)

        self.start_3D_btn = QPushButton('Démarrer 3D')
        self.start_3D_btn.clicked.connect(self.start_3D)
        layout.addWidget(self.start_3D_btn)

        #Sliders pour modifier h et P_ac
        h_layout = QHBoxLayout()
        self.h_label = QLabel(f"h: {h}")
        self.h_slider = QSlider(Qt.Orientation.Horizontal)
        self.h_slider.setMinimum(1)
        self.h_slider.setMaximum(50)
        self.h_slider.setValue(int(h))
        self.h_slider.valueChanged.connect(self.update_h)
        h_layout.addWidget(self.h_label)
        h_layout.addWidget(self.h_slider)
        layout.addLayout(h_layout)

        p_layout = QHBoxLayout()
        self.p_label = QLabel(f"P_ac: {P_ac}")
        self.p_slider = QSlider(Qt.Orientation.Horizontal)
        self.p_slider.setMinimum(1)
        self.p_slider.setMaximum(10)
        self.p_slider.setValue(int(P_ac))
        self.p_slider.valueChanged.connect(self.update_P_ac)
        p_layout.addWidget(self.p_label)
        p_layout.addWidget(self.p_slider)
        layout.addLayout(p_layout)

        #Boutons pour afficher les courbes température et énergie interne
        self.show_temp_btn = QPushButton("Voir les températures")
        self.show_temp_btn.clicked.connect(self.show_temperature_graph)
        layout.addWidget(self.show_temp_btn)

        self.show_energy_btn = QPushButton("Voir l'énergie interne")
        self.show_energy_btn.clicked.connect(self.show_energy_graph)
        layout.addWidget(self.show_energy_btn)

        self.setLayout(layout)
        self.setWindowTitle('Simulation Thermique')
      #  self.setGeometry(100, 100, 800, 600)

    def update_h(self, value):
        #mets à jour h sans redémarrer une animation
        global h
        h = value
        self.h_label.setText(f"h: {h}")
        print(f"Nouveau h: {h}")

    def update_P_ac(self, value):
        #mets à jour P sans redémarrer une animation
        global P_ac
        P_ac = value
        self.p_label.setText(f"P_ac: {P_ac}")
        print(f"Nouvelle P_ac: {P_ac}")


    def start_2D(self):
        #regarde pour arrêter l'animation en cours s'il y en a une
        if self.animation:
            self.animation.event_source.stop()
            self.animation = None

        #réinitialiser la figure et l'axe
        self.figure.clear()
        self.ax = self.figure.add_subplot(111)

        self.animate_2D()



    def animate_2D(self):
        global T, current_time  

        if self.animation:
            self.animation.event_source.stop()
            self.animation = None

        self.figure.clear()
        self.ax = self.figure.add_subplot(111)

        self.im = self.ax.imshow(T - 273.15, cmap='plasma', origin='lower', vmin=20, vmax=30, animated=True)

        #vérifier si la colorbar existe avant de la supprimer, important pour pas buger dans le transfert d'un graphique à l'autre
        if hasattr(self, 'colorbar') and self.colorbar:
            try:
                self.colorbar.remove()
            except Exception as e:
                print("Erreur lors de la suppression de la colorbar:", e)

        self.colorbar = self.figure.colorbar(self.im, ax=self.ax, label='Température (°C)')


        self.ax.set_title("Évolution 2D de la température")
        self.ax.set_xlabel("x (m)")
        self.ax.set_ylabel("y (m)")
        
        self.canvas.draw()

        def update_2D(frame):
            global T, current_time

            for _ in range(1000):
                T = vector_evolution_temperature(T, pos_ac, nx_ac, ny_ac, P_ac, P_pert, pos_pert, nx_pert, ny_pert)

                thermistance_1 = T[30, 15] - 273.15
                thermistance_2 = T[30, 60] - 273.15
                thermistance_laser = T[30, 105] - 273.15

                temp_therm_1.append(thermistance_1)
                temp_therm_2.append(thermistance_2)
                temp_therm_laser.append(thermistance_laser)

                E_current = p * cp * np.sum(T) * vol
                Energie_list.append(E_current)

                current_time += dt  

            self.im.set_data(T - 273.15)
            self.canvas.draw_idle()
            return [self.im]

        self.animation = FuncAnimation(self.figure, update_2D, frames=100, interval=50, blit=False)
        self.canvas.draw()





    def start_3D(self):
        #arrêter l'animation en cours s'il y en a une
        if self.animation:
            self.animation.event_source.stop()
            self.animation = None

        #réinitialiser la figure et l'axe
        self.figure.clear()
        self.ax = self.figure.add_subplot(111, projection='3d')

        self.animate_3D()


    def animate_3D(self):
        global T, current_time  

        if self.animation:
            self.animation.event_source.stop()
            self.animation = None

        self.figure.clear()
        self.ax = self.figure.add_subplot(111, projection='3d')

        x = np.linspace(0, Lx, n_x)
        y = np.linspace(0, Ly, n_y)
        X, Y = np.meshgrid(x, y)

    #vérifier si la colorbar existe avant de la supprimer, comme l'autre ne pas enlever important
        if hasattr(self, 'colorbar') and self.colorbar:
            try:
                self.colorbar.remove()
            except Exception as e:
                print("Erreur lors de la suppression de la colorbar:", e)

        #création de la surface initiale
        self.surf = self.ax.plot_surface(X, Y, T.T, cmap='plasma', vmin=T.min(), vmax=T.max(), animated=True)

        #création de la colorbar
        self.colorbar = self.figure.colorbar(self.surf, ax=self.ax, shrink=0.5, aspect=10)
        self.colorbar.set_label('Température (°C)')

        self.ax.set_xlabel('x (m)')
        self.ax.set_ylabel('y (m)')
        self.ax.set_zlabel('Température (°C)')
        self.ax.set_title("Évolution 3D de la température")

        self.canvas.draw()

        def update_3D(frame):
            global T, current_time

            for _ in range(1000):
                T = vector_evolution_temperature(T, pos_ac, nx_ac, ny_ac, P_ac, P_pert, pos_pert, nx_pert, ny_pert)
                
                #important pour pouvoir obtenir les graphs d'évolution de temp et énergie
                thermistance_1 = T[30, 15] - 273.15
                thermistance_2 = T[30, 60] - 273.15
                thermistance_laser = T[30, 105] - 273.15

                temp_therm_1.append(thermistance_1)
                temp_therm_2.append(thermistance_2)
                temp_therm_laser.append(thermistance_laser)

                E_current = p * cp * np.sum(T) * vol
                Energie_list.append(E_current)

                current_time += dt  

            self.ax.clear()
            self.ax.set_xlabel('x (m)')
            self.ax.set_ylabel('y (m)')
            self.ax.set_zlabel('Température (°C)')
            self.ax.set_title(f"Évolution de la température (3D) - Temps simulé : {current_time:.2f} s")

            self.surf = self.ax.plot_surface(X, Y, T.T, cmap='plasma', vmin=T.min(), vmax=T.max())

            self.canvas.draw_idle()
            return [self.surf]

        self.animation = FuncAnimation(self.figure, update_3D, frames=100, interval=50, blit=False)
        self.canvas.draw()





#afficher le graph de évolution de température
    def show_temperature_graph(self):
        #arrêter toute animation en cours
        if self.animation:
            self.animation.event_source.stop()
            self.animation = None

        #réinitialiser la figure
        self.figure.clear()
        self.ax = self.figure.add_subplot(111)

        self.ax.set_title("Évolution des températures")
        self.ax.set_xlabel("Temps (s)")
        self.ax.set_ylabel("Température (°C)")
        self.ax.grid(True)

        #vérifier si les listes contiennent des données avant d'afficher, problèmes dans le passé avec ça
        if len(temp_therm_1) > 0:
            times = np.arange(len(temp_therm_1)) * dt
            self.ax.plot(times, temp_therm_1, 'r-', label="Thermistance 1")
            self.ax.plot(times, temp_therm_2, 'y--', label="Thermistance 2")
            self.ax.plot(times, temp_therm_laser, 'k-.', label="Thermistance Laser")
            self.ax.legend()

        self.canvas.draw()  #redessine la figure pour la mise à jour

#afficher le graph d'énergie
    def show_energy_graph(self):
        #arrêter toute animation en cours
        if self.animation:
            self.animation.event_source.stop()
            self.animation = None

        #réinitialiser la figure
        self.figure.clear()
        self.ax = self.figure.add_subplot(111)

        self.ax.set_title("Évolution de l'énergie interne")
        self.ax.set_xlabel("Temps (s)")
        self.ax.set_ylabel("Énergie (J)")
        self.ax.grid(True)

        if len(Energie_list) > 0:
            times = np.arange(len(Energie_list)) * dt
            self.ax.plot(times, Energie_list, 'b-', label="Énergie interne")
            self.ax.legend()

        self.canvas.draw()  #redessiner la figure pour la mise à jour











