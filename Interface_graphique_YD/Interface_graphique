                    self.update_energy_graph()
            
            return self.surf
        
        # Lancer l'animation
        self.anim = FuncAnimation(
            self.fig_thermal,
            update,
            frames=None,  # Animation continue
            interval=self.var_animation_speed.get(),
            blit=False  # Pour la 3D, blit doit être False
        )
        
        self.canvas_thermal.draw()


# Fonction principale pour exécuter l'application
def main():
    root = tk.Tk()
    app = SimulationInterface(root)
    root.mainloop()

if __name__ == "__main__":
    main()