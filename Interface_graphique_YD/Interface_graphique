    def vector_evolution_temperature(self, T, params):
        """Calcule l'évolution de la température pour un pas de temps"""
        T_new = T.copy()
        
        # Paramètres
        a = params['a']
        dt = params['dt']
        dx = params['dx']
        dy = params['dy']
        dz = params['dz']
        vol = params['vol']
        h = params['h']
        T_air = params['T_air']
        p = params['p']
        cp = params['cp']
        
        pos_ac = params['pos_ac']
        nx_ac = params['nx_ac']
        ny_ac = params['ny_ac']
        P_ac = params['P_ac']
        
        pos_pert = params['pos_pert']
        nx_pert = params['nx_pert']
        ny_pert = params['ny_pert']
        P_pert = params['P_pert']

        # Conduction éléments centraux
        T_new[1:-1, 1:-1] = T[1:-1, 1:-1] + a*dt*((T[2:, 1:-1] - 2*T[1:-1, 1:-1] + T[0:-2, 1:-1])/(dy**2) +
                                               (T[1:-1, 2:] - 2*T[1:-1, 1:-1] + T[1:-1, 0:-2])/(dx**2))
        
        # Conduction bords et coins
        T_new[0, 1:-1] += a * dt * ((T[1, 1:-1] - T[0, 1:-1]) / dy**2 +
                                  (T[0, 2:] - 2 * T[0, 1:-1] + T[0, :-2]) / dx**2)
        
        T_new[-1, 1:-1] += a * dt * ((T[-2, 1:-1] - T[-1, 1:-1]) / dy**2 +
                                   (T[-1, 2:] - 2 * T[-1, 1:-1] + T[-1, :-2]) / dx**2)
        
        T_new[1:-1, 0] += a * dt * ((T[2:, 0] - 2 * T[1:-1, 0] + T[:-2, 0]) / dy**2 +
                                  (T[1:-1, 1] - T[1:-1, 0]) / dx**2)
        
        T_new[1:-1, -1] += a * dt * ((T[2:, -1] - 2 * T[1:-1, -1] + T[:-2, -1]) / dy**2 +
                                   (T[1:-1, -2] - T[1:-1, -1]) / dx**2)
        
        # Coins
        T_new[0, 0] += a * dt * ((T[1, 0] - T[0, 0]) / dy**2 + (T[0, 1] - T[0, 0]) / dx**2)   
        T_new[0, -1] += a * dt * ((T[1, -1] - T[0, -1]) / dy**2 + (T[0, -2] - T[0, -1]) / dx**2) 
        T_new[-1, 0] += a * dt * ((T[-2, 0] - T[-1, 0]) / dy**2 + (T[-1, 1] - T[-1, 0]) / dx**2)   
        T_new[-1, -1] += a * dt * ((T[-2, -1] - T[-1, -1]) / dy**2 + (T[-1, -2] - T[-1, -1]) / dx**2)

        # Convection
        Coeff = (h*dt)/(p*cp)
        T_new[0, :] += 1*Coeff*(T_air-T[0,:])*((dz*dx)/(vol))     # haut
        T_new[-1, :] += 1*Coeff*(T_air-T[-1,:])*((dz*dx)/(vol))   # bas
        T_new[:,0] += 1*Coeff*(T_air-T[:,0])*((dz*dy)/(vol))      # gauche
        T_new[:,-1] += 1*Coeff*(T_air-T[:,-1])*((dz*dy)/(vol))    # droite
        T_new[:,:] += 2*Coeff*(T_air-T[:,:])*((dx*dy)/vol)        # dessus/dessous

        # Actuateur
        if P_ac > 0:
            i, j = pos_ac
            i_min = max(0, i - nx_ac//2)
            i_max = min(T.shape[0], i + nx_ac//2)
            j_min = max(0, j - ny_ac//2)
            j_max = min(T.shape[1], j + ny_ac//2)
            
            n_elements = (i_max - i_min) * (j_max - j_min)
            if n_elements > 0:
                P_par_element = P_ac / n_elements
                T_new[i_min:i_max, j_min:j_max] += (P_par_element*dt)/(p*cp*vol)

        # Perturbation
        if P_pert > 0:
            k, l = pos_pert
            k_min = max(0, k - nx_pert//2)
            k_max = min(T.shape[0], k + nx_pert//2)
            l_min = max(0, l - ny_pert//2)
            l_max = min(T.shape[1], l + ny_pert//2)
            
            n_elements = (k_max - k_min) * (l_max - l_min)
            if n_elements > 0:
                P_par_element = P_pert / n_elements
                T_new[k_min:k_max, l_min:l_max] += (P_par_element*dt)/(p*cp*vol)

        return T_new

    def start_simulation(self):
        """Démarre la simulation"""
        if self.simulation_running:
            messagebox.showinfo("Information", "Une simulation est déjà en cours.")
            return
            
        # Réinitialiser les données de simulation
        self.temp_therm_1 = []
        self.temp_therm_2 = []
        self.temp_therm_laser = []
        self.energie_list = []
        self.current_time = 0
        self.frame_count = 0
        
        # Obtenir les paramètres actuels
        params = self.get_simulation_parameters()
        
        # Initialiser la matrice de température
        self.T = np.ones((params['n_x'], params['n_y'])) * params['T_air']
        
        # Démarrer l'animation en fonction du mode de visualisation
        if self.view_mode.get() == "2D":
            self.start_2d_animation(params)
        else:
            self.start_3d_animation(params)
            
        self.simulation_running = True
        self.status_var.set("Simulation en cours...")

    def stop_simulation(self):
        """Arrête la simulation"""
        if not self.simulation_running:
            return
            
        if self.anim:
            self.anim.event_source.stop()
            
        self.simulation_running = False
        self.status_var.set(f"Simulation arrêtée à {self.current_time:.2f} s")
        
        # Mise à jour des graphiques de température et d'énergie
        self.update_temperature_graph()
        self.update_energy_graph()

    def update_temperature_graph(self):
        """Met à jour le graphique d'évolution de la température"""
        if not self.temp_therm_1:
            return
            
        self.ax_temp.clear()
        
        # Échantillonnage pour éviter de tracer trop de points
        step = max(1, len(self.temp_therm_1) // 1000)
        times = [i * 0.001 for i in range(0, len(self.temp_therm_1), step)]  # dt = 0.001
        temp1 = self.temp_therm_1[::step]
        temp2 = self.temp_therm_2[::step]
        temp_laser = self.temp_therm_laser[::step]
        
        self.ax_temp.plot(times, temp1, 'r-', label='Thermistance 1')
        self.ax_temp.plot(times, temp2, 'g--', label='Thermistance 2')
        self.ax_temp.plot(times, temp_laser, 'b-.', label='Position Laser')
        
        self.ax_temp.set_xlabel("Temps (s)")
        self.ax_temp.set_ylabel("Température (°C)")
        self.ax_temp.set_title(f"Évolution des températures - Temps simulé: {self.current_time:.2f} s")
        self.ax_temp.legend()
        self.ax_temp.grid(True)
        
        self.canvas_temp.draw()

    def update_energy_graph(self):
        """Met à jour le graphique d'évolution de l'énergie interne"""
        if not self.energie_list:
            return
            
        self.ax_energy.clear()
        
        # Échantillonnage pour éviter de tracer trop de points
        step = max(1, len(self.energie_list) // 1000)
        times = [i * 0.001 for i in range(0, len(self.energie_list), step)]  # dt = 0.001
        energy = self.energie_list[::step]
        
        self.ax_energy.plot(times, energy, 'b-')
        self.ax_energy.set_xlabel("Temps (s)")
        self.ax_energy.set_ylabel("Énergie interne (J)")
        self.ax_energy.set_title(f"Évolution de l'énergie interne - Temps simulé: {self.current_time:.2f} s")
        self.ax_energy.grid(True)
        
        self.canvas_energy.draw()

    def start_2d_animation(self, params):
        """Démarre l'animation en mode 2D"""
        # Préparation du graphique 2D
        self.ax_thermal.clear()
        
        # Afficher la carte thermique initiale
        vmin = self.var_temperature_min.get() + 273.15
        vmax = self.var_temperature_max.get() + 273.15
        
        self.im = self.ax_thermal.imshow(
            self.T - 273.15,  # Convertir en Celsius pour l'affichage
            cmap='hot',
            interpolation='nearest',
            origin='lower',
            vmin=self.var_temperature_min.get(),
            vmax=self.var_temperature_max.get()
        )
        
        # Ajouter une barre de couleur
        self.fig_thermal.colorbar(self.im, ax=self.ax_thermal, label='Température (°C)')
        
        # Ajout des labels et titre
        self.ax_thermal.set_title("Simulation Thermique 2D")
        self.ax_thermal.set_xlabel("Position X")
        self.ax_thermal.set_ylabel("Position Y")
        
        # Si l'option est activée, indiquer la position de l'actuateur
        if self.var_show_actuator.get():
            i, j = params['pos_ac']
            nx, ny = params['nx_ac'], params['ny_ac']
            rect = plt.Rectangle((j - ny//2, i - nx//2), ny, nx, 
                                edgecolor='lime', facecolor='none', linewidth=2)
            self.ax_thermal.add_patch(rect)
            
        # Si l'option est activée et la perturbation est non nulle, indiquer la position de la perturbation
        if self.var_show_perturbation.get() and params['P_pert'] > 0:
            k, l = params['pos_pert']
            nx, ny = params['nx_pert'], params['ny_pert']
            rect = plt.Rectangle((l - ny//2, k - nx//2), ny, nx, 
                                edgecolor='cyan', facecolor='none', linewidth=2)
            self.ax_thermal.add_patch(rect)
            
        # Indiquer la position des thermistances
        self.ax_thermal.plot(15, 30, 'ro', markersize=5, label="Thermistance 1")
        self.ax_thermal.plot(60, 30, 'go', markersize=5, label="Thermistance 2")
        self.ax_thermal.plot(105, 30, 'bo', markersize=5, label="Position Laser")
        self.ax_thermal.legend(loc='upper right')
        
        # Mettre à jour le canvas
        self.canvas_thermal.draw()
        
        # Fonction d'initialisation pour FuncAnimation
        def init():
            self.im.set_data(self.T - 273.15)
            return [self.im]
        
        # Fonction de mise à jour pour FuncAnimation
        def update(frame):
            if not self.simulation_running or self.current_time >= params['temps_simulation']:
                self.anim.event_source.stop()
                self.simulation_running = False
                self.status_var.set(f"Simulation terminée à {self.current_time:.2f} s")
                self.update_temperature_graph()
                self.update_energy_graph()
                return [self.im]
            
            self.frame_count += 1
            
            # Calculer l'évolution pour 100 pas de temps
            for _ in range(100):
                self.T = self.vector_evolution_temperature(self.T, params)
                
                # Enregistrer les températures aux positions des thermistances
                temp1 = self.T[30, 15] - 273.15
                temp2 = self.T[30, 60] - 273.15
                temp_laser = self.T[30, 105] - 273.15
                
                self.temp_therm_1.append(temp1)
                self.temp_therm_2.append(temp2)
                self.temp_therm_laser.append(temp_laser)
                
                # Calculer l'énergie interne
                E_current = params['p'] * params['cp'] * np.sum(self.T) * params['vol']
                self.energie_list.append(E_current)
                
                self.current_time += params['dt']
            
            # Mettre à jour l'affichage
            self.im.set_data(self.T - 273.15)
            self.ax_thermal.set_title(f"Simulation Thermique 2D - Temps: {self.current_time:.2f} s")
            
            # Mettre à jour la barre de status
            self.status_var.set(f"Simulation en cours... Temps: {self.current_time:.2f} s / {params['temps_simulation']:.2f} s")
            
            # Si le temps est un multiple de 10, mettre à jour les graphiques
            if int(self.current_time) % 10 == 0 and int(self.current_time) > 0:
                if self.selected_chart.get() == "Évolution Température":
                    self.update_temperature_graph()
                elif self.selected_chart.get() == "Énergie Interne":
                    self.update_energy_graph()
            
            return [self.im]
        
        # Lancer l'animation
        self.anim = FuncAnimation(
            self.fig_thermal,
            update,
            init_func=init,
            frames=None,  # Animation continue
            interval=self.var_animation_speed.get(),
            blit=True
        )
        
        self.canvas_thermal.draw()

