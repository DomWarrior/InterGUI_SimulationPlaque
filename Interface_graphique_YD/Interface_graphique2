        # Afficher la carte thermique initiale
        vmin = self.var_temperature_min.get()
        vmax = self.var_temperature_max.get()
        
        self.im = ax.imshow(
            self.T - 273.15,  # Convertir en Celsius pour l'affichage
            cmap='hot',
            interpolation='nearest',
            origin='lower',
            vmin=vmin,
            vmax=vmax
        )
        
        # Ajouter une barre de couleur
        fig.colorbar(self.im, ax=ax, label='Température (°C)')
        
        # Ajout des labels et titre
        ax.set_title("Simulation Thermique 2D")
        ax.set_xlabel("Position X")
        ax.set_ylabel("Position Y")
        
        # Si l'option est activée, indiquer la position de l'actuateur
        if self.var_show_actuator.get():
            i, j = params['pos_ac']
            nx, ny = params['nx_ac'], params['ny_ac']
            rect = plt.Rectangle((j - ny//2, i - nx//2), ny, nx, 
                                edgecolor='lime', facecolor='none', linewidth=2)
            ax.add_patch(rect)
            
        # Si l'option est activée et la perturbation est non nulle, indiquer la position de la perturbation
        if self.var_show_perturbation.get() and params['P_pert'] > 0:
            k, l = params['pos_pert']
            nx, ny = params['nx_pert'], params['ny_pert']
            rect = plt.Rectangle((l - ny//2, k - nx//2), ny, nx, 
                                edgecolor='cyan', facecolor='none', linewidth=2)
            ax.add_patch(rect)
            
        # Indiquer la position des thermistances
        ax.plot(15, 30, 'ro', markersize=5, label="Thermistance 1")
        ax.plot(60, 30, 'go', markersize=5, label="Thermistance 2")
        ax.plot(105, 30, 'bo', markersize=5, label="Position Laser")
        ax.legend(loc='upper right')
        
        # Mettre à jour le canvas
        canvas.draw()
        
        # Fonction d'initialisation pour FuncAnimation
        def init():
            self.im.set_data(self.T - 273.15)
            return [self.im]
        
        # Fonction de mise à jour pour FuncAnimation
        def update(frame):
            if not self.simulation_running or self.current_time >= params['temps_simulation']:
                getattr(self, anim_attr).event_source.stop()
                if is_top:  # Seulement mettre à jour l'état global depuis la première animation
                    self.simulation_running = False
                    self.status_var.set(f"Simulation terminée à {self.current_time:.2f} s")
                    # Mettre à jour tous les graphiques
                    self.update_temp_graph(True)
                    self.update_temp_graph(False)
                    self.update_energy_graph(True)
                    self.update_energy_graph(False)
                return [self.im]
            
            if is_top:  # Seulement calculer l'évolution depuis la première animation
                self.frame_count += 1
                
                # Calculer le nombre d'itérations en fonction du facteur de vitesse
                iterations = int(100 * self.var_speed_factor.get())  # Base de 100 itérations
                iterations = max(1, iterations)  # Au moins 1 itération

                for _ in range(iterations):
                    self.T = self.vector_evolution_temperature(self.T, params)
    # reste du code...
                    
                    # Enregistrer les températures aux positions des thermistances
                    temp1 = self.T[30, 15] - 273.15
                    temp2 = self.T[30, 60] - 273.15
                    temp_laser = self.T[30, 105] - 273.15
                    
                    self.temp_therm_1.append(temp1)
                    self.temp_therm_2.append(temp2)
                    self.temp_therm_laser.append(temp_laser)
                    
                    # Calculer l'énergie interne
                    E_current = params['p'] * params['cp'] * np.sum(self.T) * params['vol']
                    self.energie_list.append(E_current)
                    
                    self.current_time += params['dt']
                
                # Mettre à jour les graphiques de température et d'énergie pour les deux zones
                if self.selected_chart1.get() == "Évolution Température":
                    self.update_temp_graph(True)
                elif self.selected_chart1.get() == "Énergie Interne":
                    self.update_energy_graph(True)
                    
                if self.selected_chart2.get() == "Évolution Température":
                    self.update_temp_graph(False)
                elif self.selected_chart2.get() == "Énergie Interne":
                    self.update_energy_graph(False)
                
                # Mettre à jour la barre de status
                self.status_var.set(f"Simulation en cours... Temps: {self.current_time:.2f} s / {params['temps_simulation']:.2f} s")
            
            # Mettre à jour l'affichage
            self.im.set_data(self.T - 273.15)
            ax.set_title(f"Simulation Thermique 2D - Temps: {self.current_time:.2f} s")
            
            return [self.im]
        
        # Lancer l'animation
        anim = FuncAnimation(
            fig,
            update,
            init_func=init,
            frames=None,  # Animation continue
            interval=25,
            blit=True
        )
        
        # Enregistrer l'animation dans l'attribut correspondant
        setattr(self, anim_attr, anim)
        
        canvas.draw()

