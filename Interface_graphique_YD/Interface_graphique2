        ax.set_xlabel("Temps (s)")
        ax.set_ylabel("Énergie interne (J)")
        ax.set_title(f"Évolution de l'énergie interne - Temps simulé: {self.current_time:.2f} s")
        ax.grid(True)
        
        canvas.draw()

    def start_2d_animation(self, params, is_top=True):
        """Démarre l'animation en mode 2D"""
        # Choisir les bons objets selon qu'on est en haut ou en bas
        if is_top:
