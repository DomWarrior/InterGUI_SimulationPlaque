    def vector_evolution_temperature(self, T, params):
        """Calcule l'évolution de la température pour un pas de temps"""
        T_new = T.copy()
        
        # Paramètres
        a = params['a']
        dt = params['dt']
        dx = params['dx']
        dy = params['dy']
        dz = params['dz']
        vol = params['vol']
        h = params['h']
        T_air = params['T_air']
        p = params['p']
        cp = params['cp']
        
        pos_ac = params['pos_ac']
        nx_ac = params['nx_ac']
        ny_ac = params['ny_ac']
        P_ac = params['P_ac']
        
        pos_pert = params['pos_pert']
        nx_pert = params['nx_pert']
        ny_pert = params['ny_pert']
        P_pert = params['P_pert']

        # Conduction éléments centraux
        T_new[1:-1, 1:-1] = T[1:-1, 1:-1] + a*dt*((T[2:, 1:-1] - 2*T[1:-1, 1:-1] + T[0:-2, 1:-1])/(dy**2) +
                                               (T[1:-1, 2:] - 2*T[1:-1, 1:-1] + T[1:-1, 0:-2])/(dx**2))
        
        # Conduction bords et coins
        T_new[0, 1:-1] += a * dt * ((T[1, 1:-1] - T[0, 1:-1]) / dy**2 +
                                  (T[0, 2:] - 2 * T[0, 1:-1] + T[0, :-2]) / dx**2)
        
        T_new[-1, 1:-1] += a * dt * ((T[-2, 1:-1] - T[-1, 1:-1]) / dy**2 +
                                   (T[-1, 2:] - 2 * T[-1, 1:-1] + T[-1, :-2]) / dx**2)
        
        T_new[1:-1, 0] += a * dt * ((T[2:, 0] - 2 * T[1:-1, 0] + T[:-2, 0]) / dy**2 +
                                  (T[1:-1, 1] - T[1:-1, 0]) / dx**2)
        
        T_new[1:-1, -1] += a * dt * ((T[2:, -1] - 2 * T[1:-1, -1] + T[:-2, -1]) / dy**2 +
                                   (T[1:-1, -2] - T[1:-1, -1]) / dx**2)
        
        # Coins
        T_new[0, 0] += a * dt * ((T[1, 0] - T[0, 0]) / dy**2 + (T[0, 1] - T[0, 0]) / dx**2)   
        T_new[0, -1] += a * dt * ((T[1, -1] - T[0, -1]) / dy**2 + (T[0, -2] - T[0, -1]) / dx**2) 
        T_new[-1, 0] += a * dt * ((T[-2, 0] - T[-1, 0]) / dy**2 + (T[-1, 1] - T[-1, 0]) / dx**2)   
        T_new[-1, -1] += a * dt * ((T[-2, -1] - T[-1, -1]) / dy**2 + (T[-1, -2] - T[-1, -1]) / dx**2)

        # Convection
        Coeff = (h*dt)/(p*cp)
        T_new[0, :] += 1*Coeff*(T_air-T[0,:])*((dz*dx)/(vol))     # haut
        T_new[-1, :] += 1*Coeff*(T_air-T[-1,:])*((dz*dx)/(vol))   # bas
        T_new[:,0] += 1*Coeff*(T_air-T[:,0])*((dz*dy)/(vol))      # gauche
        T_new[:,-1] += 1*Coeff*(T_air-T[:,-1])*((dz*dy)/(vol))    # droite
        T_new[:,:] += 2*Coeff*(T_air-T[:,:])*((dx*dy)/vol)        # dessus/dessous

        # Actuateur
        if P_ac > 0:
            i, j = pos_ac
            i_min = max(0, i - nx_ac//2)
            i_max = min(T.shape[0], i + nx_ac//2)
            j_min = max(0, j - ny_ac//2)
            j_max = min(T.shape[1], j + ny_ac//2)
            
            n_elements = (i_max - i_min) * (j_max - j_min)
            if n_elements > 0:
                P_par_element = P_ac / n_elements
                T_new[i_min:i_max, j_min:j_max] += (P_par_element*dt)/(p*cp*vol)

        # Perturbation
        if P_pert > 0:
            k, l = pos_pert
            k_min = max(0, k - nx_pert//2)
            k_max = min(T.shape[0], k + nx_pert//2)
            l_min = max(0, l - ny_pert//2)
            l_max = min(T.shape[1], l + ny_pert//2)
            
            n_elements = (k_max - k_min) * (l_max - l_min)
            if n_elements > 0:
                P_par_element = P_pert / n_elements
                T_new[k_min:k_max, l_min:l_max] += (P_par_element*dt)/(p*cp*vol)

        return T_new

    def start_simulation(self):
        """Démarre la simulation"""
        if self.simulation_running:
            messagebox.showinfo("Information", "Une simulation est déjà en cours.")
            return
            
        # Réinitialiser les données de simulation
        self.temp_therm_1 = []
        self.temp_therm_2 = []
        self.temp_therm_laser = []
        self.energie_list = []
        self.current_time = 0
        self.frame_count = 0
        
        # Obtenir les paramètres actuels
        params = self.get_simulation_parameters()
        
        # Initialiser la matrice de température
        self.T = np.ones((params['n_x'], params['n_y'])) * params['T_air']
        
        # Déterminer quels graphiques sont affichés et démarrer les animations
        self.simulation_running = True
        self.status_var.set("Simulation en cours...")
        
        # Déterminer les types de graphiques à afficher
        chart1 = self.selected_chart1.get()
        chart2 = self.selected_chart2.get()
        
        # Démarrer les animations respectives
        self.start_animation(chart1, params, is_top=True)
        self.start_animation(chart2, params, is_top=False)

    def start_animation(self, chart_type, params, is_top=True):
        """Démarre l'animation pour un type de graphique spécifique"""
        if chart_type == "Carte Thermique 2D":
            self.start_2d_animation(params, is_top)
        elif chart_type == "Carte Thermique 3D":
            self.start_3d_animation(params, is_top)
        elif chart_type == "Évolution Température":
            # Pour les graphiques de température et d'énergie, 
            # les mises à jour seront faites à chaque pas de temps par les autres animations
            self.update_temp_graph(is_top)
        elif chart_type == "Énergie Interne":
            self.update_energy_graph(is_top)

    def stop_simulation(self):
        """Arrête la simulation"""
        if not self.simulation_running:
            return
            
        if self.anim1:
            self.anim1.event_source.stop()
            
        if self.anim2:
            self.anim2.event_source.stop()
            
        self.simulation_running = False
        self.status_var.set(f"Simulation arrêtée à {self.current_time:.2f} s")
        
        # Mettre à jour tous les graphiques
        self.update_temp_graph(True)
        self.update_temp_graph(False)
        self.update_energy_graph(True)
        self.update_energy_graph(False)

    def update_temp_graph(self, is_top=True):
        """Met à jour le graphique d'évolution de la température"""
        if not self.temp_therm_1:
            return
            
        # Choisir les bons objets selon qu'on est en haut ou en bas
        if is_top:
            ax = self.ax_temp
            canvas = self.canvas_temp
        else:
            ax = self.ax_temp_bottom
            canvas = self.canvas_temp_bottom
            
        ax.clear()
        
        # Échantillonnage pour éviter de tracer trop de points
        step = max(1, len(self.temp_therm_1) // 1000)
        times = [i * 0.001 for i in range(0, len(self.temp_therm_1), step)]  # dt = 0.001
        temp1 = self.temp_therm_1[::step]
        temp2 = self.temp_therm_2[::step]
        temp_laser = self.temp_therm_laser[::step]
        
        ax.plot(times, temp1, 'r-', label='Thermistance 1')
        ax.plot(times, temp2, 'g--', label='Thermistance 2')
        ax.plot(times, temp_laser, 'b-.', label='Position Laser')
        
        ax.set_xlabel("Temps (s)")
        ax.set_ylabel("Température (°C)")
        ax.set_title(f"Évolution des températures - Temps simulé: {self.current_time:.2f} s")
        ax.legend()
        ax.grid(True)
        
        canvas.draw()

    def update_energy_graph(self, is_top=True):
        """Met à jour le graphique d'évolution de l'énergie interne"""
