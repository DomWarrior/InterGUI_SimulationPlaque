        ttk.Entry(frame, textvariable=self.var_pos_pert_x, width=10).grid(row=1, column=1, padx=5, pady=2)
        
        ttk.Label(frame, text="Position Y:").grid(row=2, column=0, sticky=tk.W, padx=5, pady=2)
